              }
            ],
            "url": "{{base_url}}/api/auth/password-reset/",
            "description": "Read the ignored .local-emails/ message or delivered email; paste uid/token into environment reset_uid/reset_token. No token is returned by the API.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
