                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm recovery (manual token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/auth/password-reset/confirm/",
            "description": "Single-use link, one-hour expiry. Successful confirmation invalidates prior sessions. Use new_password for subsequent login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"{{reset_uid}}\",\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"{{new_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"reset_uid\") || !pm.environment.get(\"reset_token\")) throw new Error(\"Set reset_uid and reset_token from the recovery email before running this request.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
