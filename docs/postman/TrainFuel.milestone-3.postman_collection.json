{
  "info": {
    "name": "TrainFuel — Milestone 3 training",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable test accounts; start a clean cookie jar. Exercises, prescriptions, history, tutorial ownership, revisions, and deletion."
  },
  "variable": [
    {
      "key": "api_base",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "csrf_token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.requestName === \"Get CSRF\") { for (const key of [\"run_id\",\"set1\",\"set2\",\"set3\",\"entry_id\",\"record_set\"]) pm.collectionVariables.set(key,pm.variables.replaceIn(\"{{$guid}}\")); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Get CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{api_base}}/api/auth/csrf/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "const body = pm.response.code === 204 ? {} : pm.response.json();",
              "if (body.csrf_token) pm.collectionVariables.set(\"csrf_token\", body.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register disposable training owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base}}/api/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"training-{{run_id}}@example.com\",\n  \"password\": \"Training-postman-test-password!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "const body = pm.response.code === 204 ? {} : pm.response.json();",
              "if (body.csrf_token) pm.collectionVariables.set(\"csrf_token\", body.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Controlled codes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{api_base}}/api/training/options/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "const body = pm.response.code === 204 ? {} : pm.response.json();",
              "if (body.csrf_token) pm.collectionVariables.set(\"csrf_token\", body.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create owned exercise",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base}}/api/training/exercises/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"visibility\": \"private\",\n  \"category\": \"strength\",\n  \"equipment\": \"dumbbell\",\n  \"archived\": false,\n  \"translations\": [\n    {\n      \"language\": \"en\",\n      \"name\": \"Postman row\",\n      \"instructions\": [\n        \"Brace\",\n        \"Pull smoothly\"\n      ],\n      \"technique_notes\": \"\"\n    }\n  ],\n  \"muscles\": [\n    {\n      \"code\": \"back\",\n      \"role\": \"primary\"\n    }\n  ],\n  \"media\": []\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "const body = pm.response.code === 204 ? {} : pm.response.json();",
              "if (body.csrf_token) pm.collectionVariables.set(\"csrf_token\", body.csrf_token);",
              "pm.collectionVariables.set(\"exercise_id\",body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create prescribed folder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base}}/api/training/folders/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman pull\",\n  \"position\": 1,\n  \"entries\": [\n    {\n      \"id\": \"{{entry_id}}\",\n      \"exercise_id\": \"{{exercise_id}}\",\n      \"sets\": [\n        {\n          \"id\": \"{{set1}}\",\n          \"weight_kg\": \"20.000\",\n          \"reps\": 12\n        },\n        {\n          \"id\": \"{{set2}}\",\n          \"weight_kg\": \"22.000\",\n          \"reps\": 10\n        },\n        {\n          \"id\": \"{{set3}}\",\n          \"weight_kg\": \"22.000\",\n          \"reps\": 8\n        }\n      ]\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "const body = pm.response.code === 204 ? {} : pm.response.json();",
              "if (body.csrf_token) pm.collectionVariables.set(\"csrf_token\", body.csrf_token);",
              "pm.collectionVariables.set(\"folder_id\",body.id);pm.test(\"Three independent prescriptions\",()=>pm.expect(body.entries[0].sets.map(s=>s.weight_kg)).to.eql([\"20.000\",\"22.000\",\"22.000\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create dated record",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
