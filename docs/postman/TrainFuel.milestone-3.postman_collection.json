        "url": "{{api_base}}/api/training/records/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exercise_id\": \"{{exercise_id}}\",\n  \"folder_exercise_id\": \"{{entry_id}}\",\n  \"local_date\": \"2026-10-05\",\n  \"recorded_at\": \"2026-10-05T10:00:00Z\",\n  \"kind\": \"performed\",\n  \"notes\": \"Separate from prescription\",\n  \"sets\": [\n    {\n      \"id\": \"{{record_set}}\",\n      \"weight_kg\": \"24.000\",\n      \"reps\": 8\n    }\n  ]\n}"
        }
