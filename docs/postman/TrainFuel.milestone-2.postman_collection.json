    {
      "name": "Sync lifecycle",
      "item": [
        {
          "name": "01 Register owned device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/sync/devices/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"platform\": \"web\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"device_id\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Snapshot",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/sync/snapshot/?device_id={{device_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"cursor\",pm.response.json().cursor);",
                  "pm.environment.set(\"operation_base\",pm.response.json().entities.profile[0].revision);",
                  "pm.environment.set(\"operation_key\",pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Replay local edit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/sync/push/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"operations\": [\n    {\n      \"idempotency_key\": \"{{operation_key}}\",\n      \"entity_type\": \"profile\",\n      \"entity_id\": \"{{user_id}}\",\n      \"action\": \"update\",\n      \"base_revision\": \"{{operation_base}}\",\n      \"payload\": {\n        \"display_name\": \"Offline Postman Tester\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Accepted\",()=>pm.expect(pm.response.json().results[0].status).to.eql(\"accepted\"));",
                  "pm.environment.set(\"accepted_revision\",pm.response.json().results[0].current.revision);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Retry identical operation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/sync/push/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"operations\": [\n    {\n      \"idempotency_key\": \"{{operation_key}}\",\n      \"entity_type\": \"profile\",\n      \"entity_id\": \"{{user_id}}\",\n      \"action\": \"update\",\n      \"base_revision\": \"{{operation_base}}\",\n      \"payload\": {\n        \"display_name\": \"Offline Postman Tester\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"No duplicate revision\",()=>pm.expect(pm.response.json().results[0].current.revision).to.eql(Number(pm.environment.get(\"accepted_revision\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Stale edit becomes conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/sync/push/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"operations\": [\n    {\n      \"idempotency_key\": \"{{$guid}}\",\n      \"entity_type\": \"profile\",\n      \"entity_id\": \"{{user_id}}\",\n      \"action\": \"update\",\n      \"base_revision\": \"{{operation_base}}\",\n      \"payload\": {\n        \"display_name\": \"Offline Postman Tester\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Conflict preserved\",()=>pm.expect(pm.response.json().results[0].status).to.eql(\"conflict\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Pull authorized changes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/sync/changes/?device_id={{device_id}}&after={{cursor}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"cursor\",pm.response.json().cursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Acknowledge applied cursor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/sync/ack/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"cursor\": \"{{cursor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Private media — manual file selection",
      "item": [
        {
          "name": "01 Initiate private progress upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/media/uploads/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"progress\",\n  \"visibility\": \"private\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"upload_id\",pm.response.json().upload_id);",
                  "pm.environment.set(\"asset_id\",pm.response.json().asset_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Send image bytes — select local JPEG or PNG",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/media/uploads/{{upload_id}}/content/",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "description": "Select a local file. Bytes alone do not accept a domain progress photo. Run this folder manually after Core lifecycle."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Finalize processed asset",
