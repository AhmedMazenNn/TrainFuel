{
  "info": {
    "_postman_id": "bb50b22a-22cb-47d9-b7f2-8424734909d3",
    "name": "TrainFuel Milestone 2 — Sync and private media",
    "description": "Session-cookie authentication with CSRF. Import the local environment, enable the cookie jar, and run Core lifecycle, then Negative checks. Recovery and Google folders require manual tokens. Uses test accounts only; no real credentials included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let body; try { body = pm.response.json(); } catch (_) { body = {}; }",
          "if (body.csrf_token) pm.environment.set(\"csrf_token\", body.csrf_token);",
          "const profile = body.profile || (body.user_id ? body : null);",
          "if (body.user && pm.info.requestName === \"03 Register a fresh test account\") pm.environment.set(\"user_id\", body.user.id);",
          "if (body.user) pm.environment.set(\"user_id\", body.user.id);",
          "if (body.nonce) pm.environment.set(\"google_nonce\", body.nonce);"
        ]
      }
    }
  ],
  "item": [
