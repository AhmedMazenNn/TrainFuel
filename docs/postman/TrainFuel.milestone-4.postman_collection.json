          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"local_date\": \"2026-01-02\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const nutritionResponse=pm.response.json(); if(nutritionResponse.csrf_token)pm.environment.set(\"csrf_token\",nutritionResponse.csrf_token);",
              "pm.environment.set(\"day_id\",nutritionResponse.current.id); pm.test(\"Snapshot copied\",()=>pm.expect(nutritionResponse.current.calorie_target).to.eql(\"2500.000\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create portion-total meal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
