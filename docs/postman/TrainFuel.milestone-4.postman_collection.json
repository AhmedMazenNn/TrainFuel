{
  "info": {
    "name": "TrainFuel Milestone 4 Nutrition",
    "description": "Run sequentially; generated test account, session cookies, CSRF, complete portion totals, history and stale revisions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/csrf/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const nutritionResponse=pm.response.json(); if(nutritionResponse.csrf_token)pm.environment.set(\"csrf_token\",nutritionResponse.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register isolated test account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nutrition-{{$guid}}@example.com\",\n  \"password\": \"Nutrition-postman-password!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const nutritionResponse=pm.response.json(); if(nutritionResponse.csrf_token)pm.environment.set(\"csrf_token\",nutritionResponse.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create manual schedule",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/nutrition/targets/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"effective_date\": \"2026-01-01\",\n    \"goal\": \"cutting\",\n    \"calories_kcal\": \"2500\",\n    \"protein_g\": \"150\",\n    \"carbs_g\": \"300\",\n    \"fat_g\": \"60\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const nutritionResponse=pm.response.json(); if(nutritionResponse.csrf_token)pm.environment.set(\"csrf_token\",nutritionResponse.csrf_token);",
              "pm.environment.set(\"target_id\",nutritionResponse.current.id);"
            ]
          }
        }
      ]
    },
