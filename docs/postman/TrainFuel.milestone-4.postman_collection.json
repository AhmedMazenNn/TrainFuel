          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"day\": \"{{day_id}}\",\n    \"name\": \"150 g meal\",\n    \"portion_g\": \"150\",\n    \"calories_kcal\": \"200\",\n    \"protein_g\": \"30\",\n    \"carbs_g\": \"0\",\n    \"fat_g\": \"0\",\n    \"status\": \"complete\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const nutritionResponse=pm.response.json(); if(nutritionResponse.csrf_token)pm.environment.set(\"csrf_token\",nutritionResponse.csrf_token);",
              "pm.environment.set(\"food_id\",nutritionResponse.current.id); pm.test(\"No portion scaling\",()=>pm.expect(nutritionResponse.current.protein_g).to.eql(\"30.000\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create unknown draft with explicit zero",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/nutrition/entries/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"day\": \"{{day_id}}\",\n    \"name\": \"Draft\",\n    \"portion_g\": \"150\",\n    \"calories_kcal\": null,\n    \"protein_g\": \"0\",\n    \"carbs_g\": \"0\",\n    \"fat_g\": \"0\",\n    \"status\": \"draft\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const nutritionResponse=pm.response.json(); if(nutritionResponse.csrf_token)pm.environment.set(\"csrf_token\",nutritionResponse.csrf_token);",
              "pm.test(\"Unknown stays null\",()=>pm.expect(nutritionResponse.current.calories_kcal).to.eql(null)); pm.test(\"Zero stays zero\",()=>pm.expect(nutritionResponse.current.protein_g).to.eql(\"0.000\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read weekly counters",
