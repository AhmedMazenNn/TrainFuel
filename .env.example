# Local development only. Copy to .env and replace both placeholders.
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=trainfuel
POSTGRES_USER=trainfuel
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Web authentication. Use the same hostname for browser and API requests.
FRONTEND_URL=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Google OAuth web client ID; add the frontend origins in Google Cloud Console.
GOOGLE_CLIENT_ID=
# Local reset emails are written to ignored .local-emails/. Configure SMTP to send.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=TrainFuel <no-reply@localhost>
